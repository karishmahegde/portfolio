<style>
  .hero-network {
    opacity: 0.85;
    mask-image: radial-gradient(80% 90% at 100% 0%, #000 0%, rgb(0 0 0 / 0.75) 40%, transparent 74%);
  }
  /* vector-effect isn't inherited, so set it on each line. */
  .hero-network line {
    vector-effect: non-scaling-stroke;
  }
</style>

<script>
  // Slow drift for the hero network. Each node gets its own amplitude,
  // speed and phase (derived from its index, so it's the same every visit)
  // and moves on a smooth Lissajous path around its starting point; lines
  // read their two node positions each frame.
  const svg = document.querySelector<SVGSVGElement>('.hero-network');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (svg && !reduce.matches) {
    const dots = [...svg.querySelectorAll<SVGCircleElement>('.net-dots circle')];
    const lines = [...svg.querySelectorAll<SVGLineElement>('.net-lines line')].map((el) => {
      const [a, b] = (el.dataset.n ?? '0 0').split(' ').map(Number);
      return { el, a, b };
    });

    // Small deterministic pseudo-random numbers per node (0..1).
    const hash = (n: number) => {
      const x = Math.sin(n * 127.1 + 311.7) * 43758.5453;
      return x - Math.floor(x);
    };
    const nodes = dots.map((el, i) => ({
      el,
      x0: Number(el.getAttribute('cx')),
      y0: Number(el.getAttribute('cy')),
      // Amplitude in viewBox units, scaled by size (bigger = nearer = moves more).
      ax: (4 + hash(i) * 6) * (Number(el.getAttribute('r')) / 2),
      ay: (4 + hash(i + 50) * 6) * (Number(el.getAttribute('r')) / 2),
      wx: (Math.PI * 2) / (15 + hash(i + 100) * 15), // one loop per 15-30s
      wy: (Math.PI * 2) / (15 + hash(i + 150) * 15),
      px: hash(i + 200) * Math.PI * 2,
      py: hash(i + 250) * Math.PI * 2,
      x: 0,
      y: 0,
    }));

    let frame = 0;
    let visible = false;
    const start = performance.now();

    const tick = (now: number) => {
      const t = (now - start) / 1000;
      for (const n of nodes) {
        n.x = n.x0 + n.ax * Math.sin(t * n.wx + n.px);
        n.y = n.y0 + n.ay * Math.cos(t * n.wy + n.py);
        n.el.setAttribute('cx', n.x.toFixed(1));
        n.el.setAttribute('cy', n.y.toFixed(1));
      }
      for (const { el, a, b } of lines) {
        el.setAttribute('x1', nodes[a].x.toFixed(1));
        el.setAttribute('y1', nodes[a].y.toFixed(1));
        el.setAttribute('x2', nodes[b].x.toFixed(1));
        el.setAttribute('y2', nodes[b].y.toFixed(1));
      }
      frame = requestAnimationFrame(tick);
    };

    const run = () => {
      cancelAnimationFrame(frame);
      if (visible && !document.hidden && !reduce.matches) frame = requestAnimationFrame(tick);
    };

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      run();
    }).observe(svg);
    document.addEventListener('visibilitychange', run);
    reduce.addEventListener('change', run);
  }
</script>
