---
/**
 * Shared page shell: <head>, skip link, navbar, main landmark and the
 * custom cursor. The footer is added when the pages are built.
 */
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Navbar from '../components/Navbar';
import CustomCursor from '../components/CustomCursor';
import { NAV_LINKS, RESUME_URL, SITE_NAME } from '../config/site';
import logoImage from '../assets/logo.png';

interface Props {
  /** Page name, e.g. "About me". Omit on the homepage. */
  title?: string;
  description?: string;
  /** Keep the page out of search results (used by the /tokens test page). */
  noindex?: boolean;
}

const {
  title,
  description = '[PLACEHOLDER: meta description]',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;

// The logo is shown at 56px; generate 1x-3x WebP versions instead of
// shipping the full-size PNG.
const logo = await getImage({ src: logoImage, width: 56, height: 56, densities: [1, 2, 3], format: 'webp' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <!-- Appears only on keyboard focus; jumps past the navbar. -->
    <a href="#main" class="btn btn-primary sr-only-focusable fixed top-3 left-3 z-50">
      Skip to content
    </a>

    <Navbar
      client:load
      currentPath={Astro.url.pathname}
      links={NAV_LINKS}
      resumeUrl={RESUME_URL}
      logo={{ src: logo.src, srcSet: logo.srcSet.attribute }}
    />

    <main id="main">
      <slot />
    </main>

    <!-- Footer goes here (built with the pages). -->

    <!-- Custom cursor: mouse and trackpad only; touch devices skip its JS. -->
    <CustomCursor client:media="(pointer: fine)" />
  </body>
</html>
